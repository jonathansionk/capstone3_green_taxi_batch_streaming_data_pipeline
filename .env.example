# ===============================
# BATCH PERIOD
# ===============================
BATCH_YEAR=2026
BATCH_MONTH_APRIL=04
BATCH_MONTH_MAY=05

# ===============================
# AIRFLOW
# ===============================
AIRFLOW_GCP_CONN_ID=google_cloud_default
