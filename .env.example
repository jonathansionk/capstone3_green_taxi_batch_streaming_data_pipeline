# ===============================
# BIGQUERY
# ===============================
BQ_STAGING_DATASET=your_staging_dataset
BQ_BATCH_TABLE_PREFIX=stg_green_taxi
BQ_TAXI_ZONE_TABLE=stg_taxi_zone
