GCP_REGION=asia-southeast2
GCP_LOCATION=asia-southeast2

# ===============================
# GOOGLE CLOUD STORAGE
# ===============================
GCS_BUCKET=your-student-bucket
GCS_RAW_PREFIX=data/data_raw

GCS_BATCH_APRIL_OBJECT=data/data_raw/green_tripdata_2026-04.parquet
GCS_BATCH_MAY_OBJECT=data/data_raw/green_tripdata_2026-05.parquet
